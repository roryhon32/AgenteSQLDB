# ==============================================================================
# Milia AI — Environment Configuration Template
# Renomeie este arquivo para .env e preencha com suas chaves de API.
# ==============================================================================

# Provedor LLM Principal: GroqCloud (Ultra-rápido via LPUs)
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Provedor LLM Fallback: GitHub Models (Failover automático)
# Obtenha seu token em: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_seu_token_github_aqui
GITHUB_MODEL=gpt-4o-mini

# Provedor LLM Secundário (Opcional): OpenAI
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Configurações de Banco de Dados e Aplicação
# DB_PATH=data/banco.duckdb
# PORT=8000
